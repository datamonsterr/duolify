# Self-hosted edge: static web client on /, API on /v1.
# SITE_ADDRESS=":80" serves plain HTTP on any host name (localhost, LAN).
# SITE_ADDRESS="learn.example.com" turns on automatic HTTPS (ports 80+443 must be public).
{
	admin off
}

# Security headers (snippets web_headers, sso_bridge_headers, lesson_frame_headers). Same file feeds the
# client test server, so the policy tested is the policy shipped.
import /etc/caddy/security-headers.caddy

# Container healthcheck only; this port is never published.
http://:8081 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	encode zstd gzip
	# Host-local site settings (for example `tls` with a Cloudflare origin certificate), mounted by
	# compose.prod.yml from infra/deploy/site.d/ on the VM. No match is not an error.
	import /etc/caddy/site.d/*.caddy

	handle /v1/* {
		# Voice input: one short recording (1 MB audio plus multipart framing). The proxy refuses a larger
		# body before the API sees it. The audio is never buffered to disk here (reverse_proxy streams the
		# request) and Caddy's access log records no request bodies.
		@voice path /v1/voice/transcriptions
		request_body @voice {
			max_size 1100KB
		}
		reverse_proxy {$API_UPSTREAM:api:8080} {
			# Server-sent events: flush every write, never buffer, keep streams open.
			flush_interval -1
			# A replica that dies or drops a connection: retry (GET only for failures after connect) on
			# another address for up to 5 s. Applies per request while picking an upstream; open streams are untouched.
			lb_try_duration 5s
			lb_try_interval 250ms
			transport http {
				read_timeout 0
				write_timeout 0
				keepalive 2m
			}
		}
	}

	# Sandboxed lesson slide host: its own policy (inline code, no network but the asset origin).
	handle /lesson-frame.html {
		import lesson_frame_headers
		root * /srv
		file_server
	}

	# The Clerk SSO page: the web policy plus the Clerk origins, on this one path only.
	@sso path /sso-bridge /sso-bridge/*
	handle @sso {
		import web_headers
		import sso_bridge_headers
		header Cache-Control "no-cache"
		root * /srv
		rewrite * /index.html
		file_server
	}

	handle {
		import web_headers
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}
