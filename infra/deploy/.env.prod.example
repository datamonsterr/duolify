# Production overlay settings (compose.yml + compose.prod.yml, Hetzner hel1). `infra/deploy/selfhost.sh init`
# copies this file to infra/deploy/.env (git-ignored) and fills every GENERATED value
# with a fresh random secret. Never commit the filled file. Keep a copy of it (and the
# age identity under infra/deploy/secrets/) somewhere safe: you need both to restore.
# Template for the VM: `SELFHOST_ENV_TEMPLATE=infra/deploy/.env.prod.example selfhost.sh init`.
# `infra:deploy-plan` validates this file; every variable below is required there.

# --- Locations (ADR 0014) ---
# Where the primary stack runs and where the backup/WAL/DR bucket lives. They MUST differ.
PRIMARY_LOCATION=hel1
BACKUP_LOCATION=cloudflare-r2

# --- Object storage: any S3-compatible service; the values below are Cloudflare R2 ---
# Endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto" (R2 accepts "us-east-1" as an alias).
# Addressing: the API and walship use path-style (<endpoint>/<bucket>/<key>), which R2 accepts; set
# S3_ADDRESSING_STYLE=virtual for walship if your provider needs bucket.<endpoint>. For local RustFS leave
# the defaults (http://objectstore:9000, path-style). Never commit real keys: init generates the secrets,
# you paste the provider's keys into the filled .env on the VM (the deploy job never writes them).
# Application bucket (lesson assets).
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ADDRESSING_STYLE=path
S3_BUCKET=duolify
S3_ACCESS_KEY_ID=CHANGE_ME
# Backup bucket (dumps, WAL archive, DR copy): a different bucket, ideally another R2 account or provider.
# R2 has no bucket versioning: set BACKUP_S3_VERSIONING=none so `infra:backup-lifecycle` applies expiry-only rules
# (a versioned S3 bucket keeps the default, "enabled"). On R2 protect wal/ and base/ with bucket lock rules
# (retention >= their expiry) instead of delete-less keys; see docs/infra/hardening.md. Retention is a bucket
# lifecycle rule applied with an admin token that is NOT on the VM: base/ 9 days, wal/ 10 days (7-day PITR window).
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_VERSIONING=none
BACKUP_S3_BUCKET=duolify-backups
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
# The two secret keys (S3_SECRET_ACCESS_KEY, BACKUP_S3_SECRET_ACCESS_KEY) are GENERATED below
# by init; overwrite them with the R2 token secrets before first start.

# --- Images ---
# local = build from this checkout. Otherwise pull ghcr.io images published by CI on
# main, e.g. IMAGE_REGISTRY=ghcr.io/datamonsterr/duolify IMAGE_TAG=sha-<commit>.
IMAGE_REGISTRY=duolify
IMAGE_TAG=local

# --- Edge (Caddy) ---
# ":80" = plain HTTP on any host name. A domain (duolify.online) enables automatic
# HTTPS (Cloudflare proxied: set its SSL mode to Full (strict)); its DNS must point here and ports 80/443 must be reachable from the internet.
SITE_ADDRESS=duolify.online
# Exact browser origin of the web client (scheme://host[:port]); the API's CORS allowlist.
PUBLIC_ORIGIN=https://duolify.online
# Host interface and ports for the proxy, the only published service.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- Runtime ---
# development = credential-free: sign-in codes are written to the API log instead of
# e-mailed. Use production only with RESEND_API_KEY and AUTH_MAIL_FROM set.
DUOLIFY_ENV=production
LOG_LEVEL=info
# Production e-mail sign-in (Resend). Empty in development.
RESEND_API_KEY=
AUTH_MAIL_FROM=

# --- Secrets (GENERATED by `selfhost.sh init`; change only together with the volumes) ---
POSTGRES_PASSWORD=GENERATED
JWT_SECRET=GENERATED
# RustFS root key: used only by the one-shot initializers.
S3_ROOT_SECRET_ACCESS_KEY=GENERATED
# Scoped identities provisioned by backup-init on every start.
S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_EXPIRE_S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_RESTORE_S3_SECRET_ACCESS_KEY=GENERATED
ASSET_RECOVERY_S3_SECRET_ACCESS_KEY=GENERATED
# Public age recipient for encrypted backups. The matching private identity is written
# to infra/deploy/secrets/backup-age-identity.txt (0600); move it off this machine.
BACKUP_AGE_RECIPIENT=GENERATED

# --- Providers (all off by default; the stack needs no external credentials) ---
# mock = deterministic offline engine. live needs ANTHROPIC_API_KEY or OPENROUTER_API_KEY.
ENGINE_PROVIDER_MODE=mock
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Analytics stay off unless a PostHog key is set and opt-out is false.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_OPT_OUT=true

# --- Content ---
# Logical lesson-asset origin baked into stored lesson HTML. Keep it stable across
# machines and domains (assets are served through the API, not from this origin).
LESSON_ASSET_ORIGIN=http://localhost:9000
# Host name used in public course preview links.
SHARING_PUBLIC_DOMAIN=duolify.online

# --- Resources ---
POSTGRES_MEMORY=3G
