# Production overlay settings (compose.yml + compose.prod.yml, Hetzner hel1). `infra/deploy/selfhost.sh init`
# copies this file to infra/deploy/.env (git-ignored) and fills every GENERATED value
# with a fresh random secret. Never commit the filled file. Keep a copy of it (and the
# age identity under infra/deploy/secrets/) somewhere safe: you need both to restore.
# Template for the VM: `SELFHOST_ENV_TEMPLATE=infra/deploy/.env.prod.example selfhost.sh init`.
# `infra:deploy-plan` validates this file; every variable below is required there.

# --- Locations (ADR 0014) ---
# Where the primary stack runs and where the backup/WAL/DR bucket lives. They MUST differ.
PRIMARY_LOCATION=hel1
BACKUP_LOCATION=cloudflare-r2

# --- Object storage: any S3-compatible service; the values below are Cloudflare R2 ---
# Endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto" (R2 accepts "us-east-1" as an alias).
# Addressing: the API and walship use path-style (<endpoint>/<bucket>/<key>), which R2 accepts; set
# S3_ADDRESSING_STYLE=virtual for walship if your provider needs bucket.<endpoint>. For local RustFS leave
# the defaults (http://objectstore:9000, path-style). Never commit real keys: init generates the secrets,
# you paste the provider's keys into the filled .env on the VM (the deploy job never writes them).
# Application bucket (lesson assets).
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
# R2 has no versioning; use enabled for a versioned application bucket.
S3_VERSIONING=none
S3_ADDRESSING_STYLE=path
S3_BUCKET=duolify
S3_ACCESS_KEY_ID=CHANGE_ME_APP_KEY
# Backup bucket (dumps, WAL archive, DR copy): a different bucket, ideally another R2 account or provider.
# R2 has no bucket versioning: set BACKUP_S3_VERSIONING=none so `infra:backup-lifecycle` applies expiry-only rules
# (a versioned S3 bucket keeps the default, "enabled"). On R2 protect wal/ and base/ with bucket lock rules
# (retention >= their expiry) instead of delete-less keys; see docs/infra/hardening.md. Retention is a bucket
# lifecycle rule applied with an admin token that is NOT on the VM: base/ 9 days, wal/ 10 days (7-day PITR window).
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_VERSIONING=none
BACKUP_S3_BUCKET=duolify-backups
# MUST differ from S3_ACCESS_KEY_ID: the API refuses to start when the backup writer reuses the application
# key, and `infra:deploy-plan` (run by deploy.sh before it pulls anything) rejects the same value.
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_BACKUP_KEY
# The two secret keys (S3_SECRET_ACCESS_KEY, BACKUP_S3_SECRET_ACCESS_KEY) are GENERATED below
# by init; overwrite them with the R2 token secrets before first start.

# --- Images ---
# local = build from this checkout. Otherwise pull ghcr.io images published by CI on
# main, e.g. IMAGE_REGISTRY=ghcr.io/datamonsterr/duolify IMAGE_TAG=sha-<commit>.
IMAGE_REGISTRY=duolify
IMAGE_TAG=local

# --- Edge (Caddy) ---
# ":80" = plain HTTP on any host name. A domain (duolify.online) enables automatic
# HTTPS (Cloudflare proxied: set its SSL mode to Full (strict)); its DNS must point here and ports 80/443 must be reachable from the internet.
SITE_ADDRESS=duolify.online
# Exact browser origin of the web client (scheme://host[:port]); the API's CORS allowlist and the
# origin cookie-mode web sign-in accepts. On staging/production it must be https with no path.
PUBLIC_ORIGIN=https://duolify.online
# Optional comma-separated override of the allowlist (for example the web and the API host names).
# API_ALLOWED_ORIGINS=https://duolify.online,https://api.duolify.online
# Host interface and ports for the proxy, the only published service.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- Runtime ---
# development = credential-free: sign-in codes are written to the API log instead of
# e-mailed. Use production only with RESEND_API_KEY and AUTH_MAIL_FROM set.
DUOLIFY_ENV=production
LOG_LEVEL=info
# Production e-mail sign-in (Resend). Empty in development.
RESEND_API_KEY=
AUTH_MAIL_FROM=
# Clerk web sign-in (all empty = off). The secret and publishable key are set together;
# CLERK_AUTHORIZED_PARTIES lists the web origin(s) (comma-separated, same as PUBLIC_ORIGIN).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_KEY=

# --- Secrets (GENERATED by `selfhost.sh init`; change only together with the volumes) ---
POSTGRES_PASSWORD=GENERATED
JWT_SECRET=GENERATED
# RustFS root key: used only by the one-shot initializers.
S3_ROOT_SECRET_ACCESS_KEY=GENERATED
# Scoped identities provisioned by backup-init on every start.
S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_EXPIRE_S3_SECRET_ACCESS_KEY=GENERATED
BACKUP_RESTORE_S3_SECRET_ACCESS_KEY=GENERATED
ASSET_RECOVERY_S3_SECRET_ACCESS_KEY=GENERATED
# Public age recipient for encrypted backups (age1 + 58 characters). `selfhost.sh up` generates the pair on a
# fresh machine; a CI deploy never does, so on a VM deployed by deploy.sh generate it ONCE yourself
# (`age-keygen -o backup-age-identity.txt`, paste the "Public key" line here), keep the private identity
# off the VM (password manager plus an offline copy) and never regenerate it: old backups need the old
# identity. `infra:deploy-plan` rejects a missing or malformed value. See docs/infra/staging.md.
BACKUP_AGE_RECIPIENT=GENERATED

# --- Providers (all off by default; the stack needs no external credentials) ---
# live is required when DUOLIFY_ENV is staging or production (the engine refuses mock there) and
# needs OPENROUTER_API_KEY. mock = deterministic offline engine for development and tests only.
ENGINE_PROVIDER_MODE=live
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Analytics stay off unless a PostHog key is set and opt-out is false.
# Private worker-only credentials for deleting persons and events after account erasure.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_OPT_OUT=true

# --- Narration (ElevenLabs, ADR 0009) ---
# NARRATION_ENABLED turns on the API/worker narration queue; the engine synthesises live only with
# NARRATION_LIVE_ENABLED=true plus ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID (otherwise a mock voice).
NARRATION_ENABLED=false
NARRATION_LIVE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Live synthesis budget per subscription month (read only with NARRATION_LIVE_ENABLED=true): the
# character allowance, the percentage at which new synthesis stops, and the day the cycle resets.
NARRATION_MONTHLY_CHAR_LIMIT=40000
NARRATION_BUDGET_STOP_PERCENT=95
NARRATION_CYCLE_START_DAY=1

# --- Content ---
# Public origin of the lesson assets. It is baked into stored lesson HTML and is the only origin the
# lesson iframe's CSP lets a slide load from, so on staging/production it must be a real https origin
# (`infra:deploy-plan` rejects localhost): with R2, the custom domain of the application bucket
# (R2 bucket > Settings > Custom Domains), for example https://assets.duolify.online. Choose it before the
# first lesson is generated and keep it stable afterwards. http://localhost:9000 is for development only.
LESSON_ASSET_ORIGIN=https://assets.duolify.online
# Landing video base for the web build (`LANDING_MEDIA_BASE` repo variable in pr-ready; VITE_LANDING_MEDIA_BASE for local
# compose builds). Must sit on LESSON_ASSET_ORIGIN (CSP media-src). Empty = the landing shows only the poster.
VITE_LANDING_MEDIA_BASE=https://assets.duolify.online/landing/v1
# Host name used in public course preview links.
SHARING_PUBLIC_DOMAIN=duolify.online

# --- Resources (cx23: 2 vCPU, 4 GB; budget table in docs/infra/hardening.md, 'Sizing') ---
# Postgres container limit; shared_buffers and friends in compose.prod.yml are sized for it. `infra:deploy-plan`
# rejects limits that add up to more than 3.5 GB across the services that run on the VM.
POSTGRES_MEMORY=1280M
# Database connections per process (per API replica and for the worker). All processes together must stay
# under max_connections (60) with room for a third API replica during a rolling restart: deploy-plan checks it.
# API_DB_POOL_MAX_CONNS=10
# API_DB_POOL_MIN_CONNS=2
# WORKER_DB_POOL_MAX_CONNS=16
# WORKER_DB_POOL_MIN_CONNS=4
# Drain after SIGTERM on deploy (defaults shown). compose stop_grace_period is 120s; keep it >= drain + 15s.
# API_DRAIN_TIMEOUT=90s
# WORKER_DRAIN_TIMEOUT=90s
# ENGINE_DRAIN_TIMEOUT_SECS=90

# Immersive Lesson player and voice input need no extra variables here. Voice uses OPENROUTER_API_KEY,
# REDIS_URL (rate and daily-cap counters) and the active pricing version's transcription rate.
# Caddy caps the transcription request body at 1100 KB (infra/deploy/Caddyfile).
