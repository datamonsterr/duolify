# Copy to .env (git-ignored). mise loads it automatically.
# Values marked HUMAN must be filled in by a person. Others have working local defaults.

# --- Runtime ---
# Only an explicit development value enables local mail/log and placeholder keys.
# Unset, production, and every other value enforce production auth and CORS.
DUOLIFY_ENV=development
LOG_LEVEL=info

# --- API (services/api) ---
API_ADDR=:8080
DATABASE_URL=postgres://duolify:duolify@localhost:5432/duolify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ENGINE_ADDR=http://localhost:50051
# HUMAN: random 32+ byte secret, e.g. `openssl rand -base64 48`
# Production: random secret >=32 bytes (for example 32 random bytes encoded as hex).
JWT_SECRET=change-me-development-only-at-least-32-bytes
# HUMAN: Resend API key. Production only; development/CI use the log-only Mailer.
RESEND_API_KEY=
# HUMAN: verified Resend sender, e.g. Duolify <sign-in@your-domain.example>.
AUTH_MAIL_FROM=
# HUMAN / E1-10: Apple sign-in stays disabled until owner provisions a Services ID.
APPLE_CLIENT_ID=
# HUMAN / E1-10: Apple team identifier for the client-secret JWT signer.
APPLE_TEAM_ID=
# HUMAN / E1-10: Apple Sign in with Apple key identifier.
APPLE_KEY_ID=
# HUMAN / E1-10: Apple ES256 private key (never commit a value).
APPLE_PRIVATE_KEY=
# Maximum Unicode characters in each optional goal, topic and background (1–16384).
PROFILE_TEXT_LIMIT=2000
# Comma-separated existing account UUIDs granted pricing_admin at API startup.
# Set only through the operator deployment path; no HTTP self-service exists.
PRICING_ADMIN_IDS=
# The launch owner account UUID; only this account may use ADR 0011's adverse
# self-approval exception, and only after the configured notice window.
PRICING_OWNER_ID=

# Read-only Stripe price lookup credentials (test/live are separate). Empty disables
# pricing approval/activation; existing read-only catalogue browsing still works.
STRIPE_PRICING_TEST_SECRET_KEY=
STRIPE_PRICING_LIVE_SECRET_KEY=
# Explicit synthetic mapping verifier; allowed ONLY with DUOLIFY_ENV=development/test
# and no Stripe pricing credentials. Never enable in production.
ALLOW_FAKE_PRICING_VERIFIER=false
# Optional operator JSON minima; draft values can only tighten protections.
# Defaults: 70% margin, 0.0015 USD/Credit, packs 0.029 + 0.30 USD,
# subscriptions 0.036 + 0.30 USD, refund reserve 0.020. Lower minima are rejected.
PRICING_ECONOMICS_MINIMUMS=
# Positive auth limits per rolling hour. Defaults preserve the strict production policy.
AUTH_CODE_REQUESTS_PER_IP_PER_HOUR=20
# Per email AND client IP; one sender cannot exhaust another sender's budget.
AUTH_CODE_REQUESTS_PER_EMAIL_PER_HOUR=3
# Silent global delivery cap; active codes remain verifiable. Resends have a 60s cooldown.
AUTH_CODE_DELIVERIES_PER_EMAIL_PER_HOUR=10
# X-Forwarded-For trusted hops from the right. 0 ignores forwarded headers.
# Set only behind a proxy that appends the actual peer and blocks direct ingress.
AUTH_TRUSTED_PROXY_HOPS=0
AUTH_CODE_VERIFICATIONS_PER_IP_PER_HOUR=60
# Integration flag gating E4-01 lesson generation, gated test tracer routes (/v1/lessons/*, /v1/lesson-generations/*) and worker (default off until E4-02/E4-03 pass)
LESSON_TEST_TRACER_ENABLED=false
# Spaced retries and variant limits for lesson test (defaults: min_gap=2, max_variants_per_topic=3, max_variants_per_test=12, session_ttl=168h/7d)
LESSON_TEST_MIN_GAP=2
LESSON_TEST_MAX_VARIANTS_PER_TOPIC=3
LESSON_TEST_MAX_VARIANTS_PER_TEST=12
# Configured TTL before an in-progress lesson test session is abandoned (default 7 days / 168h)
LESSON_TEST_SESSION_TTL=168h

# --- Object storage (RustFS locally, Railway Bucket in cloud) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=duolify
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=duolify
S3_SECRET_ACCESS_KEY=duolify-dev-secret
# Local initializer/retention administrator only; never forwarded to API/worker.
S3_ROOT_ACCESS_KEY_ID=duolify-admin
# Local-only root fixture secret; production uses separately provisioned identities.
S3_ROOT_SECRET_ACCESS_KEY=local-rustfs-admin-only

# --- Backup storage and account deletion ledger ---
# API and worker require scoped backup storage for startup deletion replay.
# Local RustFS endpoint; cloud uses the separately provisioned backup bucket.
BACKUP_S3_ENDPOINT=http://localhost:9000
# Dedicated backup bucket region.
BACKUP_S3_REGION=us-east-1
# Must differ from S3_BUCKET; never expire account-deletions/v1/ ledger objects.
BACKUP_S3_BUCKET=duolify-backups
# Dedicated put/get writer without delete or bucket-administration permissions.
BACKUP_S3_ACCESS_KEY_ID=duolify-backup-writer
# Local-only fixture credential; replace with a secret-managed scoped key in cloud.
BACKUP_S3_SECRET_ACCESS_KEY=local-backup-writer-only
# Separate retention identity: list + delete dumps only (never the account-deletions ledger).
BACKUP_EXPIRE_S3_ACCESS_KEY_ID=duolify-backup-expirer
# Local-only fixture credential; use a secret-managed scoped key in cloud.
BACKUP_EXPIRE_S3_SECRET_ACCESS_KEY=local-backup-expirer-only
# Read-only restore identity for restore drills.
BACKUP_RESTORE_S3_ACCESS_KEY_ID=duolify-backup-restorer
# Local-only fixture credential; use a secret-managed scoped key in cloud.
BACKUP_RESTORE_S3_SECRET_ACCESS_KEY=local-backup-restorer-only
# Operator identity that restores/regenerates versioned application objects (no delete rights).
ASSET_RECOVERY_S3_ACCESS_KEY_ID=duolify-asset-recovery
# Local-only fixture credential; use a secret-managed scoped key in cloud.
ASSET_RECOVERY_S3_SECRET_ACCESS_KEY=local-asset-recovery-only
# Backup retention in days; may only be raised above the approved 14 (general) / 35 (financial).
BACKUP_GENERAL_RETENTION_DAYS=14
BACKUP_FINANCIAL_RETENTION_DAYS=35
# Public X25519 recipient from age-keygen; recovery private key stays outside the worker.
BACKUP_AGE_RECIPIENT=
# Scheduled restore drill only (owner-provided; leave empty locally and the drill skips with a notice).
# Private age identity (AGE-SECRET-KEY-...) used to decrypt dumps inside the throwaway drill; never given to the worker.
BACKUP_AGE_IDENTITY=
# Optional host port overrides for isolated synthetic backup checks/worktrees.
POSTGRES_PORT=5432
# Redis host port (container-to-container connections still use service DNS).
REDIS_PORT=6379
# RustFS S3 host port; update host-side S3_ENDPOINT when overriding.
S3_PORT=9000
# RustFS console host port.
S3_CONSOLE_PORT=9001

# --- Engine (engine/) ---
ENGINE_ADDR_LISTEN=0.0.0.0:50051
# Set to "mock" to run without provider keys (tests, CI drafts).
ENGINE_PROVIDER_MODE=mock
# HUMAN: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# HUMAN: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# HUMAN: https://elevenlabs.io/app/settings/api-keys (slide narration, ADR 0009)
ELEVENLABS_API_KEY=
# Per-slide narration synthesis worker (E14). Default off: live narration stays disabled until
# E10-06 gates promotion; the engine only has the deterministic mock provider for now.
NARRATION_ENABLED=false
# Live ElevenLabs synthesis (E14-04). Off unless this is "true" AND ELEVENLABS_API_KEY and
# ELEVENLABS_VOICE_ID are set; otherwise the engine uses the deterministic mock. Gated by E14-05.
NARRATION_LIVE_ENABLED=false
# Engine narration voice config (no secrets). The model must match the priced quote route.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Days an unreferenced narration asset is kept after its last Lesson reference ends (E14-02).
NARRATION_RETENTION_DAYS=30

# --- Stripe fixture boundary ---
# Stripe E7-06: disabled by default. Test providers are explicitly injected only
# by fixture binaries; no real API keys or live billing adapter are shipped.
STRIPE_MODE=disabled
# Webhook endpoint signing secret; never commit a real secret. Test fixtures use
# an authored fake secret, not this deployment setting.
STRIPE_WEBHOOK_SECRET=
# E7-05 human approval is still required. true/live mode is rejected in E7-06.
STRIPE_LIVE_ENABLED=false

# --- Evals ---
# API report ingest bearer token for trusted eval services; POST /v1/eval/reports is disabled when unset.
EVAL_REPORT_SERVICE_TOKEN=
# HUMAN: https://huggingface.co/settings/tokens (read access to the golden-set dataset)
HF_TOKEN=
HF_GOLDEN_DATASET=datamonsterr/duolify-golden
HF_GOLDEN_REVISION=
# S3 / object-store mirror endpoint for offline recovery of pinned golden set revisions
# HF_GOLDEN_MIRROR_URL=http://localhost:9000/duolify/golden-mirror
# E10-06 live evaluation budget cap (in USD); evaluations stop immediately when reached.
EVAL_BUDGET_USD=5.00
# Sample limit for stratified evaluation runs in CI / local testing.
EVAL_SAMPLE_LIMIT=10
# Set true in CI to report explicit missing-secret status without failing ci-ok aggregate.
ALLOW_MISSING_SECRETS=false

# --- Analytics ---
# HUMAN: PostHog project API key (public, client-side) and host
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Private operational metrics listener; API defaults 127.0.0.1:9091,
# worker defaults 127.0.0.1:9092. Containers override on their private network.
# Leave empty for those defaults; never expose this listener through public ingress.
OPERATIONS_ADDR=
# E11 HTTP/gRPC acceptance ports isolated from other epics on the shared host.
E11_API_E2E_ADDR=127.0.0.1:4114
E11_GRPC_E2E_ADDR=127.0.0.1:4115
# HUMAN / E1-07: PostHog project ID for server-side person deletion requests.
POSTHOG_PROJECT_ID=
# Set true to suppress every server analytics event, including system backups.
ANALYTICS_OPT_OUT=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Client (apps/client) ---
VITE_API_URL=http://localhost:8080
# Client integration flag for E4-01 lesson generation and gated test tracer (default false)
VITE_LESSON_TEST_TRACER_ENABLED=false

# Optional isolated Playwright ports for parallel worktrees (E1 uses 4010-4019).
E2E_WEB_PORT=4010
E2E_API_BASE=http://127.0.0.1:4011

# Optional package filter for api:test-integration; unset to run the full task.
# API_TEST_PACKAGES=./internal/notes/...

# Production brief chat additionally requires approved Pricing and live eval promotion (E12-10/E10-06).
COURSE_BRIEF_CHAT_LIVE_APPROVED=false

# Explicit flag gating unapproved pricing versions (e.g. character_create proposal in development/test).
# Defaults to false (off). Strictly forbidden in production (or unknown/empty env); API fails startup if enabled there.
ALLOW_UNAPPROVED_PRICING=false

# --- Feature flags ---
# E17-01: Provisional mascot fixture art is not launch approval. Defaults to false (off) when unset; set true explicitly for development and testing.
FEATURE_CUSTOM_CHARACTERS=false

# Exact public asset origin allowed in lesson iframe CSP (no path or credentials).
LESSON_ASSET_ORIGIN=http://localhost:9000

# --- Course sharing (E15-01, ADR 0012 interim defaults) ---
# Minimum account age to publish a Course. Conservative default 18. Publishing stays disabled until an age source exists.
SHARING_MIN_PUBLISHER_AGE=18
# Include narration asset refs in published snapshots. Default false until ElevenLabs redistribution is confirmed.
SHARING_INCLUDE_NARRATION=false
# Platform-funded screening cost cap per draft, in USD nanos (1e9 = $1). Default 250000000 = $0.25. Can only lower the default.
SHARING_SCREEN_MAX_COST_NANOS=250000000

# --- Course sharing public preview (E15-02) ---
# Domain for public preview URLs: https://${domain}/preview/${token}. Default: localhost (never noindex-exempt).
SHARING_PUBLIC_DOMAIN=localhost
# Deep-link scheme for the "Open in app" button: ${scheme}://share/${token}. Default: duolify.
SHARING_APP_SCHEME=duolify
# Per-IP sliding-window rate limit on the public preview endpoint. Default: 60 requests per 60-second window.
SHARING_PREVIEW_RATE_LIMIT_PER_IP=60
SHARING_PREVIEW_RATE_WINDOW_SECONDS=60
# New course copies one account may create from share links, invites or the marketplace per rolling 24 hours.
SHARING_MAX_ENROLLMENTS_PER_DAY=30
# Playback milliseconds for a reused slide whose snapshot carries no duration (1000-120000).
SHARING_COPY_SLIDE_MS=8000

# --- Public Marketplace (E15-07) ---
# Release flag. OFF by default: the Marketplace stays hidden (neutral 404 on every route) until moderation (E15-10),
# takedown (E15-11) and legal approval (ADR 0012). Only the exact word "true" turns it on.
MARKETPLACE_ENABLED=false
# Listing eligibility caps. Defaults: account at least 3 days old, at least 3 generated lessons, 5 topic tags, 20 listings per owner.
MARKETPLACE_MIN_ACCOUNT_AGE_DAYS=3
MARKETPLACE_MIN_LESSONS=3
MARKETPLACE_MAX_TAGS=5
MARKETPLACE_MAX_LISTINGS_PER_OWNER=20
# Catalogue page size (default 20), its maximum (50) and the longest search text in characters (100).
MARKETPLACE_PAGE_SIZE=20
MARKETPLACE_MAX_PAGE_SIZE=50
MARKETPLACE_MAX_QUERY_LENGTH=100
# Bayesian rating: minimum count C (default 10) and the prior mean 1-5 used until any course has ratings (default 3.5).
MARKETPLACE_RATING_MIN_COUNT=10
MARKETPLACE_RATING_PRIOR=3.5
# Seconds a Redis result page may be served before Postgres is read again. Redis is derived: loss only rebuilds it.
MARKETPLACE_CACHE_TTL_SECONDS=60

# --- Course invites (E15-06) ---
# Invites one learner may send per rolling 24 hours (default 20), days until a pending invite expires (30),
# days a final invite is kept before it is purged (90), and push attempts before a failure is final (3).
SHARING_INVITES_PER_DAY=20
# E15-05: versions an owner may republish per Course per rolling day, and the owner changelog length (characters).
SHARING_MAX_REPUBLISHES_PER_DAY=3
SHARING_MAX_CHANGELOG_LENGTH=500
SHARING_INVITE_EXPIRY_DAYS=30
SHARING_INVITE_PURGE_DAYS=90
SHARING_PUSH_MAX_ATTEMPTS=3
# Push adapter: "disabled" (default; invites are in-app only) or "fake" (dev and tests only, refused when DUOLIFY_ENV=production).
PUSH_ADAPTER=disabled
# APNs/FCM credentials come only from the secret store (Railway variables), never the repository. None exist yet (ADR 0012)
# and no live transport is built before E15-12, so setting them does not enable push; the API logs a warning instead.
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_P8=
PUSH_FCM_SERVICE_ACCOUNT_JSON=

# Review prerequisites, rolling 24h submission/edit cap, Unicode text bound and platform USD nanos.
SHARING_REVIEW_MIN_LESSONS=3
SHARING_REVIEWS_PER_DAY=20
SHARING_REVIEW_MAX_CHARS=2000
SHARING_REVIEW_MAX_COST_NANOS=20000000

# Optional tooling baseline for proto:breaking in shared worktrees (default main).
PROTO_BREAKING_REF=main
