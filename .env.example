# Copy to .env (git-ignored). mise loads it automatically.
# Values marked HUMAN must be filled in by a person. Others have working local defaults.

# --- Runtime ---
# Only an explicit development value enables local mail/log and placeholder keys.
# Unset, production, and every other value enforce production auth and CORS.
DUOLIFY_ENV=development
LOG_LEVEL=info

# --- API (services/api) ---
API_ADDR=:8080
DATABASE_URL=postgres://duolify:duolify@localhost:5432/duolify?sslmode=disable
# pgx pool of each process (every API replica and the worker has its own). Empty = the defaults shown.
# Keep the sum over all processes, plus one API replica during a rolling restart, under Postgres
# max_connections (infra:deploy-plan checks it for the production overlay: API 10, worker 16, max 60).
# A pool_max_conns style parameter in DATABASE_URL is honoured when the matching variable is empty.
# DB_POOL_MAX_CONNS=10
# DB_POOL_MIN_CONNS=2
# DB_POOL_MAX_CONN_LIFETIME=30m
# DB_POOL_MAX_CONN_IDLE_TIME=5m
# DB_POOL_HEALTH_CHECK_PERIOD=1m
# DB_CONNECT_TIMEOUT=3s
REDIS_URL=redis://localhost:6379/0
ENGINE_ADDR=http://localhost:50051
# HUMAN: random 32+ byte secret, e.g. `openssl rand -base64 48`
# Production: random secret >=32 bytes (for example 32 random bytes encoded as hex).
# Also encrypts the independent Clerk erasure ledger; escrow for recovery and migrate
# ledger encryption with the old key before rotating this secret.
JWT_SECRET=change-me-development-only-at-least-32-bytes
# HUMAN: Resend API key. Production only; development/CI use the log-only Mailer.
RESEND_API_KEY=
# HUMAN: verified Resend sender, e.g. Duolify <sign-in@your-domain.example>.
AUTH_MAIL_FROM=
# --- Clerk SSO (ADR 0016: Google, Apple and future social providers) ---
# Leave BOTH keys empty to switch SSO off: the buttons are hidden and email-code sign-in still works.
# HUMAN: Clerk secret key (sk_...). Server only; never ship it to the client. The worker also uses it
# to delete the Clerk user when a Duolify account is erased (delete-clerk-user-on-erasure); empty = no call.
CLERK_SECRET_KEY=
# HUMAN: Clerk publishable key (pk_...). The API serves it to the client via GET /v1/auth/sso/config,
# so no VITE_ copy and no client rebuild is needed.
CLERK_PUBLISHABLE_KEY=
# HUMAN: comma-separated web origins allowed as the session token `azp`, e.g.
# https://duolify.online,https://staging.duolify.online,http://localhost:1420
CLERK_AUTHORIZED_PARTIES=
# Optional: Clerk instance PEM public key (Dashboard > API keys > Show JWT public key) for networkless
# token verification. Empty: the API fetches and caches the JWKS from Clerk.
CLERK_JWT_KEY=
# Client build (native apps only): web origin that serves /sso-bridge. Defaults to https://duolify.online
# in desktop Tauri builds and to the page origin on the web; mobile build tasks use staging.
VITE_SSO_BRIDGE_URL=
# Maximum Unicode characters in each optional goal, topic and background (1–16384).
PROFILE_TEXT_LIMIT=2000
# Comma-separated existing account UUIDs granted pricing_admin at API startup.
# Set only through the operator deployment path; no HTTP self-service exists.
PRICING_ADMIN_IDS=
# The launch owner account UUID; only this account may use ADR 0011's adverse
# self-approval exception, and only after the configured notice window.
PRICING_OWNER_ID=

# Read-only Stripe price lookup credentials (test/live are separate). Empty disables
# pricing approval/activation; existing read-only catalogue browsing still works.
STRIPE_PRICING_TEST_SECRET_KEY=
STRIPE_PRICING_LIVE_SECRET_KEY=
# Explicit synthetic mapping verifier; allowed ONLY with DUOLIFY_ENV=development/test
# and no Stripe pricing credentials. Never enable in production.
ALLOW_FAKE_PRICING_VERIFIER=false
# Optional operator JSON minima; draft values can only tighten protections.
# Defaults: 70% margin, 0.0015 USD/Credit, packs 0.029 + 0.30 USD,
# subscriptions 0.036 + 0.30 USD, refund reserve 0.020. Lower minima are rejected.
PRICING_ECONOMICS_MINIMUMS=
# Positive auth limits per rolling hour. Defaults preserve the strict production policy.
AUTH_CODE_REQUESTS_PER_IP_PER_HOUR=20
# Per email AND client IP; one sender cannot exhaust another sender's budget.
AUTH_CODE_REQUESTS_PER_EMAIL_PER_HOUR=3
# Silent global delivery cap; active codes remain verifiable. Resends have a 60s cooldown.
AUTH_CODE_DELIVERIES_PER_EMAIL_PER_HOUR=10
# Comma-separated exact browser origins (scheme://host[:port]) allowed to call the API
# in every environment, e.g. a self-hosted web client. Empty = Tauri/dev origins only.
# The same list is the only set of origins allowed to use the web refresh cookie
# (persist-web-session): set it to the public web origin (PUBLIC_ORIGIN in deploy).
API_ALLOWED_ORIGINS=
# X-Forwarded-For trusted hops from the right. 0 ignores forwarded headers.
# Set only behind a proxy that appends the actual peer and blocks direct ingress.
AUTH_TRUSTED_PROXY_HOPS=0
AUTH_CODE_VERIFICATIONS_PER_IP_PER_HOUR=60
# Kill switch for the lesson test: direct lesson generation, test routes (/v1/lessons/*, /v1/lesson-generations/*) and the lesson worker.
# On by default in every environment (ADR 0017); set false to disable.
LESSON_TEST_TRACER_ENABLED=true
# Development only: POST /v1/me/check-in grants nothing, so browser suites that assert exact wallets stay deterministic. Ignored unless DUOLIFY_ENV=development.
CHECK_IN_DISABLED=false
# Spaced retries and variant limits for lesson test (defaults: min_gap=2, max_variants_per_topic=3, max_variants_per_test=12, session_ttl=168h/7d)
LESSON_TEST_MIN_GAP=2
LESSON_TEST_MAX_VARIANTS_PER_TOPIC=3
LESSON_TEST_MAX_VARIANTS_PER_TEST=12
# Configured TTL before an in-progress lesson test session is abandoned (default 7 days / 168h)
LESSON_TEST_SESSION_TTL=168h
# Row retention sweep (worker). Idempotency-only rows older than the window are deleted in batches.
# Playback sync events (default 30d); durations like 720h or 30d.
PLAYBACK_SYNC_EVENT_RETENTION=30d
# Lesson test answer operations (default 7d); never lower than LESSON_TEST_SESSION_TTL.
LESSON_TEST_ANSWER_OPERATION_RETENTION=7d
# How often the sweep runs (default 24h) and rows deleted per statement (default 5000).
ROW_RETENTION_SWEEP_INTERVAL=24h
ROW_RETENTION_BATCH_SIZE=5000

# --- Object storage (RustFS locally, Railway Bucket in cloud) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=duolify
S3_REGION=us-east-1
# enabled for versioned application buckets; none for R2 (which does not support versioning).
S3_VERSIONING=enabled
S3_ACCESS_KEY_ID=duolify
S3_SECRET_ACCESS_KEY=duolify-dev-secret
# Local initializer/retention administrator only; never forwarded to API/worker.
S3_ROOT_ACCESS_KEY_ID=duolify-admin
# Local-only root fixture secret; production uses separately provisioned identities.
S3_ROOT_SECRET_ACCESS_KEY=local-rustfs-admin-only

# --- Backup storage and account deletion ledger ---
# API and worker require scoped backup storage for startup deletion replay.
# Local RustFS endpoint; cloud uses the separately provisioned backup bucket.
BACKUP_S3_ENDPOINT=http://localhost:9000
# Dedicated backup bucket region.
BACKUP_S3_REGION=us-east-1
# Must differ from S3_BUCKET; never expire account-deletions/v1/ ledger objects.
BACKUP_S3_BUCKET=duolify-backups
# Dedicated put/get writer without delete or bucket-administration permissions.
BACKUP_S3_ACCESS_KEY_ID=duolify-backup-writer
# Local-only fixture credential; replace with a secret-managed scoped key in cloud.
BACKUP_S3_SECRET_ACCESS_KEY=local-backup-writer-only
# Separate retention identity: list + delete dumps only (never the account-deletions ledger).
BACKUP_EXPIRE_S3_ACCESS_KEY_ID=duolify-backup-expirer
# Local-only fixture credential; use a secret-managed scoped key in cloud.
BACKUP_EXPIRE_S3_SECRET_ACCESS_KEY=local-backup-expirer-only
# Read-only restore identity for restore drills.
BACKUP_RESTORE_S3_ACCESS_KEY_ID=duolify-backup-restorer
# Local-only fixture credential; use a secret-managed scoped key in cloud.
BACKUP_RESTORE_S3_SECRET_ACCESS_KEY=local-backup-restorer-only
# Operator identity that restores/regenerates versioned application objects (no delete rights).
ASSET_RECOVERY_S3_ACCESS_KEY_ID=duolify-asset-recovery
# Local-only fixture credential; use a secret-managed scoped key in cloud.
ASSET_RECOVERY_S3_SECRET_ACCESS_KEY=local-asset-recovery-only
# Backup retention in days; may only be raised above the approved 14 (general) / 35 (financial).
BACKUP_GENERAL_RETENTION_DAYS=14
BACKUP_FINANCIAL_RETENTION_DAYS=35
# Public X25519 recipient from age-keygen; recovery private key stays outside the worker.
BACKUP_AGE_RECIPIENT=
# Scheduled restore drill only (owner-provided; leave empty locally and the drill skips with a notice).
# Private age identity (AGE-SECRET-KEY-...) used to decrypt dumps inside the throwaway drill; never given to the worker.
BACKUP_AGE_IDENTITY=
# Quarterly financial restore replay uses independently supplied TEST fixtures only.
DRILL_FINANCIAL_REPLAY=false
# Exact canonical fixture JSON (mode=test; sessions, invoices, subscriptions arrays).
BACKUP_FINANCIAL_FIXTURES=
# Hex HMAC-SHA256 of the exact fixture JSON, using the separate owner-held key.
BACKUP_FINANCIAL_FIXTURE_SIGNATURE=
# Owner-held TEST fixture signing key; never a live provider credential.
BACKUP_FINANCIAL_FIXTURE_KEY=
# Optional host port overrides for isolated synthetic backup checks/worktrees.
POSTGRES_PORT=5432
# Redis host port (container-to-container connections still use service DNS).
REDIS_PORT=6379
# RustFS S3 host port; update host-side S3_ENDPOINT when overriding.
S3_PORT=9000
# RustFS console host port.
S3_CONSOLE_PORT=9001
# API and Engine host ports (override to run a second stack).
API_PORT=8080
ENGINE_PORT=50051

# --- Engine (engine/) ---
ENGINE_ADDR_LISTEN=0.0.0.0:50051
# Set to "mock" to run without provider keys (tests, CI drafts).
ENGINE_PROVIDER_MODE=mock
# No longer used by the engine (ADR 0015: every task runs on OpenRouter). Kept empty for old tooling.
# HUMAN: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Required for live mode: OpenRouter is the only provider (ADR 0015). Set the model allowlist,
# no-training and daily budget guardrails on this key in the OpenRouter dashboard.
# HUMAN: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# HUMAN: https://elevenlabs.io/app/settings/api-keys (slide narration, ADR 0009)
ELEVENLABS_API_KEY=
# Per-slide narration synthesis worker (E14). Default off: live narration stays disabled until
# E10-06 gates promotion; the engine only has the deterministic mock provider for now.
NARRATION_ENABLED=false
# Live ElevenLabs synthesis (E14-04). Off unless this is "true" AND ELEVENLABS_API_KEY and
# ELEVENLABS_VOICE_ID are set; otherwise the engine uses the deterministic mock. Gated by E14-05.
NARRATION_LIVE_ENABLED=false
# Engine narration voice config (no secrets). The model must match the priced quote route.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Monthly ElevenLabs character budget, enforced before every live TTS request when
# NARRATION_LIVE_ENABLED=true (ADR 0015: Starter plan, 40,000 characters per subscription month).
# Usage is counted from stored narration assets and regenerations in Postgres; reused or shared
# audio is free. Past the stop percent of the limit no live call is made: slides stay captions-only,
# a narration_budget_exhausted PostHog event fires and an ERROR log line is written (alert on it).
# Keep the limit equal to the plan; the stop percent is the safety margin for concurrent runs.
NARRATION_MONTHLY_CHAR_LIMIT=40000
NARRATION_BUDGET_STOP_PERCENT=95
# Day of month (1-28, UTC) the ElevenLabs subscription cycle resets; the count restarts then.
NARRATION_CYCLE_START_DAY=1
# Days an unreferenced narration asset is kept after its last Lesson reference ends (E14-02).
NARRATION_RETENTION_DAYS=30

# --- Stripe fixture boundary ---
# Stripe E7-06: disabled by default. Test providers are explicitly injected only
# by fixture binaries; no real API keys or live billing adapter are shipped.
STRIPE_MODE=disabled
# Webhook endpoint signing secret; never commit a real secret. Test fixtures use
# an authored fake secret, not this deployment setting.
STRIPE_WEBHOOK_SECRET=
# E7-05 human approval is still required. true/live mode is rejected in E7-06.
STRIPE_LIVE_ENABLED=false

# --- Evals ---
# API report ingest bearer token for trusted eval services; POST /v1/eval/reports is disabled when unset.
EVAL_REPORT_SERVICE_TOKEN=
# HUMAN: https://huggingface.co/settings/tokens (read access to the golden-set dataset)
HF_TOKEN=
HF_GOLDEN_DATASET=datamonsterr/duolify-golden
HF_GOLDEN_REVISION=
# S3 / object-store mirror endpoint for offline recovery of pinned golden set revisions
# HF_GOLDEN_MIRROR_URL=http://localhost:9000/duolify/golden-mirror
# E10-06 live evaluation budget cap (in USD); evaluations stop immediately when reached.
EVAL_BUDGET_USD=5.00
# Live golden eval reads the preview envelope from this API's active pricing.
EVAL_PRICING_URL=http://127.0.0.1:8080/v1/pricing
# Sample limit for stratified evaluation runs in CI / local testing.
EVAL_SAMPLE_LIMIT=10
# Set true in CI to report explicit missing-secret status without failing ci-ok aggregate.
ALLOW_MISSING_SECRETS=false

# --- Analytics ---
# HUMAN: PostHog project API key (public, client-side) and ingestion host. Duolify uses PostHog
# US cloud (project "Duolify", id in POSTHOG_PROJECT_ID); the ingestion host is us.i.posthog.com
# and the app/API host (derived by `mise run api:posthog-setup`) is us.posthog.com.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# HUMAN: PostHog personal API key (secret, server/ops only) used by `mise run api:posthog-verify`
# and `api:posthog-setup` to query events and provision the AI dashboard, and by the worker job
# `posthog_person_deletion` to delete the PostHog person of an erased learner (needs POSTHOG_PROJECT_ID
# too; without both the job is not scheduled). Never ship it to a client.
POSTHOG_PERSONAL_API_KEY=
# Private operational metrics listener; API defaults 127.0.0.1:9091,
# worker defaults 127.0.0.1:9092. Containers override on their private network.
# Leave empty for those defaults; never expose this listener through public ingress.
OPERATIONS_ADDR=
# E11 HTTP/gRPC acceptance ports isolated from other epics on the shared host.
E11_API_E2E_ADDR=127.0.0.1:4114
E11_GRPC_E2E_ADDR=127.0.0.1:4115
# HUMAN / E1-07: PostHog project ID (US cloud) for server-side person deletion requests and the ops tasks.
POSTHOG_PROJECT_ID=
# Set true to suppress every server analytics event, including system backups.
ANALYTICS_OPT_OUT=false
# Client PostHog project key (same public key as POSTHOG_API_KEY) and US ingestion host, read at build time.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Landing video base, read at build time: <LESSON_ASSET_ORIGIN>/landing/v1. Empty = the landing shows only the poster.
VITE_LANDING_MEDIA_BASE=

# --- Client (apps/client) ---
# Local web development; mobile build tasks override this with the staging API by default.
VITE_API_URL=http://localhost:8080
# Guided chat rollout per flow (conversational-flows-and-mascot). Unset or true shows the chat, false
# shows the old form (kept one release for rollback), ab serves the chat to half of the Learners by id.
# Flows: ONBOARDING, COURSE_BRIEF, SIGNIN, REST.
VITE_FEATURE_GUIDED_ONBOARDING=
VITE_FEATURE_GUIDED_COURSE_BRIEF=
VITE_FEATURE_GUIDED_SIGNIN=
VITE_FEATURE_GUIDED_REST=
# Set by mobile build tasks to ios or android for existing analytics events.
VITE_MOBILE_PLATFORM=
# Client kill switch for the lesson test (on by default, ADR 0017); set false to hide it.
VITE_LESSON_TEST_TRACER_ENABLED=true

# Optional isolated Playwright ports for parallel worktrees (E1 uses 4010-4019).
E2E_WEB_PORT=4010
E2E_API_BASE=http://127.0.0.1:4011
# Optional. Write Character acceptance screenshots at both viewport sizes and themes.
# CHARACTER_APPROVAL_DIR=

# Full-stack flow suite (mise run client:e2e-stack*, infra/e2e). All optional; leave commented.
# Emulator CI may bind the disposable stack on 0.0.0.0 and explicitly allow native webview origins.
# E2E_STACK_BIND_ADDRESS=127.0.0.1
# E2E_STACK_ALLOWED_ORIGINS=http://localhost:18471,http://tauri.localhost,https://tauri.localhost
# Browser origin under test; default is the local e2e stack. A remote URL skips the local stack.
# E2E_STACK_URL=http://localhost:18471
# Host port of the local e2e stack proxy (127.0.0.1 only).
# E2E_STACK_PORT=18471
# 1 = engine uses the live OpenRouter route (needs OPENROUTER_API_KEY; costs money). Default mock.
# E2E_LIVE=0
# Lesson generation and lesson test in the e2e stack (LESSON_TEST_TRACER_ENABLED); default true like production.
# E2E_LESSON_TEST_TRACER_ENABLED=true
# Remote stacks only: shell command printing every sign-in code sent to $1, oldest first.
# E2E_STACK_CODE_COMMAND=
# Remote stacks only: shell command recording a credit purchase for learner $1, amount $2
# (card payments are off). Unset on a remote stack: flows that need paid credits are fixme.
# E2E_STACK_GRANT_COMMAND=
# Screenshot and flows.json folder; default apps/client/test-results/stack-flows.
# E2E_STACK_SHOTS_DIR=
# Run only flows whose title matches this regex, e.g. "F1|F2".
# E2E_FLOW=

# Optional package filter for api:test-integration; unset to run the full task.
# API_TEST_PACKAGES=./internal/notes/...

# Production brief chat additionally requires approved Pricing and live eval promotion (E12-10/E10-06).
COURSE_BRIEF_CHAT_LIVE_APPROVED=false

# Explicit flag gating unapproved pricing versions (e.g. character_create proposal in development/test).
# Defaults to false (off). Strictly forbidden in production (or unknown/empty env); API fails startup if enabled there.
ALLOW_UNAPPROVED_PRICING=false

# --- Feature flags ---
# E17-01: Provisional mascot fixture art is not launch approval. Defaults to false (off) when unset; set true explicitly for development and testing.
FEATURE_CUSTOM_CHARACTERS=false

# Exact public asset origin allowed in lesson iframe CSP (no path or credentials).
LESSON_ASSET_ORIGIN=http://localhost:9000

# Web client build only: base URL of the landing page video, WebM and poster, normally
# ${LESSON_ASSET_ORIGIN}/landing/v1 (upload with `mise run infra:landing-media-upload <dir> v1`).
# Unset: the landing shows the poster without a player. Native builds never show the landing.
VITE_LANDING_MEDIA_BASE=

# --- Course sharing (E15-01, ADR 0012 interim defaults) ---
# Minimum publisher age from account birth date (server UTC). Values below 18 are rejected.
SHARING_MIN_PUBLISHER_AGE=18
# Reference the owner's narration audio in published snapshots so shared copies reuse it (ADR 0013). Default true; set false to turn reuse off (learners then regenerate narration).
SHARING_INCLUDE_NARRATION=true
# Platform-funded screening cost cap per draft, in USD nanos (1e9 = $1). Default 250000000 = $0.25. Can only lower the default.
SHARING_SCREEN_MAX_COST_NANOS=250000000

# --- Course sharing public preview (E15-02) ---
# Domain for public preview URLs: https://${domain}/preview/${token}. Default: localhost (never noindex-exempt).
SHARING_PUBLIC_DOMAIN=localhost
# Deep-link scheme for the "Open in app" button: ${scheme}://share/${token}. Default: duolify.
SHARING_APP_SCHEME=duolify
# Per-IP sliding-window rate limit on the public preview endpoint. Default: 60 requests per 60-second window.
SHARING_PREVIEW_RATE_LIMIT_PER_IP=60
SHARING_PREVIEW_RATE_WINDOW_SECONDS=60
# New course copies one account may create from share links, invites or the marketplace per rolling 24 hours.
SHARING_MAX_ENROLLMENTS_PER_DAY=30
# Playback milliseconds for a reused slide whose snapshot carries no duration (1000-120000).
SHARING_COPY_SLIDE_MS=8000

# --- Public Marketplace (E15-07) ---
# Release flag. OFF by default: the Marketplace stays hidden (neutral 404 on every route) until moderation (E15-10),
# takedown (E15-11) and legal approval (ADR 0012). Only the exact word "true" turns it on.
MARKETPLACE_ENABLED=false
# Listing eligibility caps. Defaults: account at least 3 days old, at least 3 generated lessons, 5 topic tags, 20 listings per owner.
MARKETPLACE_MIN_ACCOUNT_AGE_DAYS=3
MARKETPLACE_MIN_LESSONS=3
MARKETPLACE_MAX_TAGS=5
MARKETPLACE_MAX_LISTINGS_PER_OWNER=20
# Catalogue page size (default 20), its maximum (50) and the longest search text in characters (100).
MARKETPLACE_PAGE_SIZE=20
MARKETPLACE_MAX_PAGE_SIZE=50
MARKETPLACE_MAX_QUERY_LENGTH=100
# Bayesian rating: minimum count C (default 10) and the prior mean 1-5 used until any course has ratings (default 3.5).
MARKETPLACE_RATING_MIN_COUNT=10
MARKETPLACE_RATING_PRIOR=3.5
# Seconds a Redis result page may be served before Postgres is read again. Redis is derived: loss only rebuilds it.
MARKETPLACE_CACHE_TTL_SECONDS=60

# --- Course invites (E15-06) ---
# Invites one learner may send per rolling 24 hours (default 20), days until a pending invite expires (30),
# days a final invite is kept before it is purged (90), and push attempts before a failure is final (3).
SHARING_INVITES_PER_DAY=20
# E15-05: versions an owner may republish per Course per rolling day, and the owner changelog length (characters).
SHARING_MAX_REPUBLISHES_PER_DAY=3
SHARING_MAX_CHANGELOG_LENGTH=500
SHARING_INVITE_EXPIRY_DAYS=30
SHARING_INVITE_PURGE_DAYS=90
SHARING_PUSH_MAX_ATTEMPTS=3
# Push adapter: "disabled" (default; invites are in-app only) or "fake" (dev and tests only, refused when DUOLIFY_ENV=production).
PUSH_ADAPTER=disabled
# APNs/FCM credentials come only from the secret store (Railway variables), never the repository. None exist yet (ADR 0012)
# and no live transport is built before E15-12, so setting them does not enable push; the API logs a warning instead.
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_P8=
PUSH_FCM_SERVICE_ACCOUNT_JSON=

# Review prerequisites, rolling 24h submission/edit cap, Unicode text bound and platform USD nanos.
SHARING_REVIEW_MIN_LESSONS=3
SHARING_REVIEWS_PER_DAY=20
SHARING_REVIEW_MAX_CHARS=2000
SHARING_REVIEW_MAX_COST_NANOS=20000000

# Reports (E15-09): configured reasons (subset of unsafe,inappropriate,spam,copyright,misleading,other), rolling 24h cap,
# optional text bound (Unicode characters, at most 500), distinct reporters that hide a course, retention in days (365-3650).
SHARING_REPORT_REASONS=unsafe,inappropriate,spam,copyright,misleading,other
SHARING_REPORTS_PER_DAY=10
SHARING_REPORT_MAX_CHARS=500
SHARING_REPORT_HIDE_THRESHOLD=3
SHARING_REPORT_RETENTION_DAYS=1095
# E15-10 moderation: first-response target in hours, reason text and appeal text limits, severe
# reason codes (a takedown with one of these also blocks existing copies), audit retention in days.
# Moderators are granted in the moderator_grants table by the project owner; there is no API for it.
SHARING_MODERATION_TARGET_HOURS=48
SHARING_MODERATION_REASON_MAX_CHARS=1000
SHARING_APPEAL_MAX_CHARS=1000
SHARING_MODERATION_SEVERE_CODES=unsafe,legal
SHARING_MODERATION_RETENTION_DAYS=1095
# E15-11: days published lesson objects are kept after the last copy that uses them ends, then purged by
# the retention job (default 30, at least 15 so a restorable nightly dump never points at purged objects).
SHARING_ASSET_PURGE_DAYS=30
# Release readiness only reports these; owner and legal approval are human gates (ADR 0012). Default false.
# Neither one turns MARKETPLACE_ENABLED on.
SHARING_RELEASE_LEGAL_APPROVED=false
SHARING_RELEASE_CDN_POLICY_APPROVED=false

# Optional tooling baseline for proto:breaking in shared worktrees (default main).
PROTO_BREAKING_REF=main
# E17-09: all release/rights/evaluation evidence is required; live public Character export stays OFF.
CHARACTER_PUBLIC_EXPORTS_ENABLED=false
CHARACTER_REDISTRIBUTION_APPROVED=false
CHARACTER_VOICES_APPROVED=false
CHARACTER_PUBLICATION_LIVE_EVAL_APPROVED=false

# Immersive Lesson player (change immersive-mobile-lesson-player): no environment variables. Voice
# limits (1 MB, 30 s, 6 per minute) are constants in services/api/internal/voice; the daily cap and the
# transcription rate come from the active pricing version; the transcription models are in
# engine/config/models.toml and use OPENROUTER_API_KEY. The Lesson player settings (full screen on
# rotate, autoplay, auto-send after dictation) are per-Learner profile columns, default on.
# Voice stays unavailable until the active pricing version carries a transcription rate.

# SSE keepalive comment interval (Go duration). Must stay under 25s so streams survive the Cloudflare proxy read timeout (125s).
SSE_HEARTBEAT_INTERVAL=15s

# Graceful deploy drain: after SIGTERM, in-flight requests, jobs and Engine RPCs may finish this long.
# compose stop_grace_period (120s) must stay at least 15s longer; deploy-plan.sh checks it.
# API_DRAIN_TIMEOUT=90s
# WORKER_DRAIN_TIMEOUT=90s
# ENGINE_DRAIN_TIMEOUT_SECS=90

# Input guard (ADR 0025): when true the API asks the engine to guard learner free text (course topic, setup and brief
# answers, outline chat, quick notes, tutor chat) before any main-model call. Leave unset until the engine has passing
# live `input_guard` evidence; it is off by default and changes nothing when off.
INPUT_GUARD_ENABLED=
